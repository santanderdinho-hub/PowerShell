# ─────────────────────────────────────────────────────────────
# PromoHunt — credenciais (preencha UMA vez; nada vai por parâmetro)
# Copie este arquivo para ".env" e preencha. Cada marketplace só liga
# se as variáveis dele estiverem preenchidas.
# NUNCA versione o .env (já está no .gitignore).
# ─────────────────────────────────────────────────────────────

# Porta do servidor local
PORT=3001

# ── SHOPEE (Programa de Afiliados) ───────────────────────────
# Pegue em: https://affiliate.shopee.com.br -> Open API -> App ID / Secret
# Essas chaves NÃO expiram: preencheu uma vez, funciona pra sempre.
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ── MERCADO LIVRE (API oficial, renova o token sozinho) ──────
# Crie um app em https://developers.mercadolivre.com.br -> Minhas aplicações.
# Pegue Client ID, Client Secret e cadastre um Redirect URI.
# IMPORTANTE: o ML exige HTTPS e RECUSA localhost. Não precisa ser um site
# seu — pode ser uma URL pública que mostre a query string. Recomendado:
# https://httpbin.org/anything (mostra o "code" na própria página).
# Use o MESMO valor aqui e no campo "URIs de redirect" do painel do ML.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://httpbin.org/anything
# (opcional) sua tag de afiliado, anexada nos links do ML
MELI_AFFILIATE_TAG=
#
# Depois de preencher os 3 acima, rode UMA vez pra autorizar:
#   npm run meli-auth                 (imprime a URL pra autorizar)
#   npm run meli-auth -- <CODE>       (troca o code e salva o refresh token)
# A partir daí o app renova o access token automaticamente.
#
# Alternativa simples (sem auto-refresh): em vez do bloco acima, cole um
# access token manual aqui — mas ele expira em ~6h e você terá que trocar.
# MELI_ACCESS_TOKEN=

# ── GERADOR DE POST (aba "Gerar post") ───────────────────────
# Usado pra etiquetar links de afiliado de QUALQUER URL que você colar.
# Shopee usa a API acima (gera link curto). Amazon/Magalu só precisam da tag:
AMAZON_PARTNER_TAG=
MAGALU_AFFILIATE_ID=
