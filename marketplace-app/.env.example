# ─────────────────────────────────────────────────────────────
# PromoHunt — credenciais das APIs oficiais de afiliado
# Copie este arquivo para ".env" e preencha o que você tiver.
# Cada marketplace SÓ é ativado se as variáveis dele estiverem
# preenchidas. O que faltar simplesmente não aparece no painel.
# NUNCA versione o arquivo .env (ele está no .gitignore).
# ─────────────────────────────────────────────────────────────

# Porta do servidor local
PORT=3001

# ── SHOPEE (Programa de Afiliados — recomendado) ─────────────
# Onde pegar: https://affiliate.shopee.com.br -> Open API -> gerar App ID/Secret
SHOPEE_APP_ID=
SHOPEE_SECRET=

# ── MERCADO LIVRE (API oficial) ──────────────────────────────
# Crie um app em https://developers.mercadolivre.com.br -> Minhas aplicações
# e gere um access token (OAuth2). Cole o token abaixo.
MELI_ACCESS_TOKEN=
# (opcional) seu identificador/parâmetro de afiliado, se usar o gerador de links
MELI_AFFILIATE_TAG=

# ── AMAZON (Associados BR / Product Advertising API 5.0) ─────
# Requer conta de Associados com vendas qualificadas + chaves PA-API.
# Mesmo sem a API, basta o PARTNER_TAG para etiquetar links de afiliado.
AMAZON_PARTNER_TAG=
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=

# ── MAGALU (Parceiro Magalu / Divulgador) ────────────────────
# Magalu não expõe API pública de ofertas. Informe seu ID de
# divulgador para etiquetar links, se aplicável.
MAGALU_AFFILIATE_ID=
